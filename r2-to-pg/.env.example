# =============================================================================
# .env.example — Salin ke .env dan isi nilainya
# JANGAN commit file .env ke git!
# =============================================================================

# --- DATABASE TARGET ---
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_ADMIN_DB=postgres

# --- CLOUDFLARE R2 ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=your-bucket-name
R2_PREFIX=pg-backups

# Opsional: restore file tertentu.
# Jika kosong, script akan auto-pilih file *.dump.gz terbaru dari prefix.
R2_OBJECT=

# --- OPSI RESTORE ---
CLEAN_BEFORE_RESTORE=true
CREATE_DB_IF_NOT_EXISTS=true
POST_RESTORE_ANALYZE=false

# --- OPSI KONEKSI ---
DB_CONNECT_TIMEOUT=30
